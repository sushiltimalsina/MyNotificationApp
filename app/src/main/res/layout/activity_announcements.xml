<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_horizontal"
        android:paddingTop="@dimen/screen_vertical"
        android:paddingEnd="@dimen/screen_horizontal"
        android:paddingBottom="32dp">

        <!-- Header -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="12dp"
                android:text="‹  Back"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="@dimen/body_text" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="@string/announcements"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/title_text"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/announcement_settings_description"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/body_text" />

        <!-- eSewa -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/esewa_announcements"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/section_text"
                android:textStyle="bold" />

            <!-- Received -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/received_transactions"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/body_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/announce_received_description"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/tiny_text" />

                </LinearLayout>

                <Switch
                    android:id="@+id/esewaReceivedSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:showText="false" />

            </LinearLayout>

            <!-- Sent -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sent_transactions"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/body_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/announce_sent_description"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/tiny_text" />

                </LinearLayout>

                <Switch
                    android:id="@+id/esewaSentSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:showText="false" />

            </LinearLayout>

        </LinearLayout>

        <!-- Khalti -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/khalti_announcements"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/section_text"
                android:textStyle="bold" />

            <!-- Received -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/received_transactions"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/body_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/announce_received_description"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/tiny_text" />

                </LinearLayout>

                <Switch
                    android:id="@+id/khaltiReceivedSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:showText="false" />

            </LinearLayout>

            <!-- Sent -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sent_transactions"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/body_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/announce_sent_description"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/tiny_text" />

                </LinearLayout>

                <Switch
                    android:id="@+id/khaltiSentSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:showText="false" />

            </LinearLayout>

        </LinearLayout>

        <!-- Status -->

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/announcement_enabled"
            android:textColor="@color/success"
            android:textSize="@dimen/small_text"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>