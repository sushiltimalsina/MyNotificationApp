<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:layout_marginTop="30dp">

    <!-- Header -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/screen_horizontal"
        android:paddingTop="14dp"
        android:paddingEnd="@dimen/screen_horizontal"
        android:paddingBottom="14dp">

        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="‹ Back"
            android:textAllCaps="false"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:minWidth="40dp"
            android:padding="0dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/about_wallet_speaker"
            android:textAlignment="center"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/title_text"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_horizontal"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/screen_horizontal"
            android:paddingBottom="24dp">

            <!-- App identity -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wallet_speaker"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/about_tagline"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/small_text" />

            </LinearLayout>

            <!-- What it does -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/about_what_it_does"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/section_text"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/about_what_it_does_text"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/small_text" />

            <!-- Supported wallets -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_supported_wallets"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/body_text"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/about_supported_wallets_text"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/small_text" />

            </LinearLayout>

            <!-- Features -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_features"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/body_text"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/about_features_text"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/small_text" />

            </LinearLayout>

            <!-- Voice -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_voice"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/body_text"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/about_voice_text"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/small_text" />

            </LinearLayout>

            <!-- Privacy -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_privacy"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/body_text"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/about_privacy_text"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/small_text" />

            </LinearLayout>

            <!-- Important -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_requirements"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/body_text"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/about_requirements_text"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/small_text" />

            </LinearLayout>

            <!-- App information -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="@string/about_version"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/tiny_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:text="@string/about_developer"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/tiny_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/about_footer"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/tiny_text" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
