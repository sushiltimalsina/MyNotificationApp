<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_horizontal"
        android:paddingTop="@dimen/screen_vertical"
        android:paddingEnd="@dimen/screen_horizontal"
        android:paddingBottom="32dp">

        <!-- Header -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="12dp"
                android:text="‹  Back"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="@dimen/body_text" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="@string/voice"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/title_text"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Voice status -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/voice_status"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/section_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/voiceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/checking_voice"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/body_text" />

            <TextView
                android:id="@+id/voiceDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/voice_checking_details"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/small_text" />

            <Button
                android:id="@+id/ttsSettingsButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:text="@string/open_tts_settings"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/body_text"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Speech rate -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/speech_rate"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/section_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/speechRateValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/small_text" />

            <SeekBar
                android:id="@+id/speechRateSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="20"
                android:progress="10" />

        </LinearLayout>

        <!-- Pitch -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pitch"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/section_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pitchValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/small_text" />

            <SeekBar
                android:id="@+id/pitchSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="20"
                android:progress="10" />

        </LinearLayout>

        <!-- Test voice -->

        <Button
            android:id="@+id/testVoiceButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_primary_button"
            android:text="@string/test_voice"
            android:textAllCaps="false"
            android:textColor="@color/surface"
            android:textSize="@dimen/body_text"
            android:textStyle="bold" />

        <!-- Volume information -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/voice_volume_note"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/small_text" />

    </LinearLayout>

</ScrollView>