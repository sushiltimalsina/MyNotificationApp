    <string name="how_it_works">How Wallet Speaker Works</string>
    <string name="how_it_works_title">Automatic wallet transaction announcements</string>
    <string name="how_it_works_description">Wallet Speaker monitors supported eSewa and Khalti notifications and announces recognized transactions using Nepali text-to-speech.</string>
    <string name="how_it_works_points">• Works while your phone screen is locked when Android delivers the notification to Wallet Speaker.`n• Announces supported received and sent transactions.`n• Ignores promotional and non-transaction wallet notifications.`n• Transactions can still be recorded when speech for that transaction type is turned off.`n• Voice rate and pitch can be configured from Settings → Voice.`n• Speech volume follows your phone media volume.`n• Notification access must remain enabled for transaction detection.</string>

    <string name="about_wallet_speaker">About Wallet Speaker</string>
    <string name="about_tagline">Smart wallet transaction voice announcer</string>
    <string name="about_what_it_does">What Wallet Speaker Does</string>
    <string name="about_what_it_does_text">Wallet Speaker automatically detects supported eSewa and Khalti wallet transaction notifications and announces recognized transactions using Nepali text-to-speech.</string>
    <string name="about_supported_wallets">Supported Wallets</string>
    <string name="about_supported_wallets_text">• eSewa\n• Khalti</string>
    <string name="about_features">Features</string>
    <string name="about_features_text">• Received and sent transaction detection\n• Nepali amount-to-words conversion\n• Sender information when available\n• Transaction history\n• Configurable speech rate and pitch\n• Separate announcement controls for wallet transaction types\n• Works with the phone screen locked when Android delivers the notification\n• Filters promotional and non-transaction wallet notifications</string>
    <string name="about_voice">Voice &amp; Language</string>
    <string name="about_voice_text">Wallet Speaker uses your device text-to-speech engine with Nepali language support. Speech rate and pitch can be adjusted from the Voice settings page. Announcement volume follows your phone media volume.</string>
    <string name="about_privacy">Privacy</string>
    <string name="about_privacy_text">Wallet Speaker uses wallet notification information on your device to identify transactions, maintain transaction history, and generate announcements. It does not require your eSewa or Khalti password.</string>
    <string name="about_requirements">Important</string>
    <string name="about_requirements_text">Wallet Speaker depends on Android Notification Listener access. Android or device-specific battery and background restrictions may affect whether notifications are delivered to the app.</string>
    <string name="about_version">Version 1.0.0</string>
    <string name="about_developer">Developed by Sushil Timalsina</string>
    <string name="about_footer">Made for simple and accessible wallet transaction announcements.</string>
